<Window x:Class="CybersecurityAwarenessBotPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="750" Width="900"
        MinHeight="650" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#102A43"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="&#x1F512; CYBERSECURITY AWARENESS"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Stay safe. Stay secure."
                           FontSize="14"
                           Foreground="#B9D7EA"
                           TextAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Task Management Panel -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="#D9E2EC"
                BorderThickness="1">

            <StackPanel>
                <TextBlock Text="TASK MANAGEMENT"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#102A43"
                           Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,10">
                    <TextBox x:Name="TaskTitleInput"
                             Width="170"
                             Height="32"
                             Margin="0,0,8,5"
                             Padding="6"
                             ToolTip="Task title"/>

                    <TextBox x:Name="TaskDescriptionInput"
                             Width="190"
                             Height="32"
                             Margin="0,0,8,5"
                             Padding="6"
                             ToolTip="Task description"/>

                    <DatePicker x:Name="TaskReminderDatePicker"
                                Width="145"
                                Height="32"
                                Margin="0,0,8,5"/>

                    <Button Content="Add Task"
                            Width="90"
                            Height="32"
                            Margin="0,0,0,5"
                            Background="#147D64"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="AddTaskButton_Click"/>
                </WrapPanel>

                <TextBlock Text="Saved Tasks"
                           FontWeight="SemiBold"
                           Foreground="#243B53"
                           Margin="0,0,0,5"/>

                <ListBox x:Name="TaskListBox"
                         Height="85"
                         BorderBrush="#D9E2EC"
                         BorderThickness="1"
                         Margin="0,0,0,8">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           Width="250"/>

                                <TextBlock Text="{Binding Status}"
                                           Foreground="#147D64"
                                           Width="100"/>

                                <TextBlock Text="{Binding ReminderDate, StringFormat={}{0:dd MMM yyyy}}"
                                           Foreground="#627D98"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel>
                    <Button Content="Mark Complete"
                            Width="125"
                            Margin="0,0,8,0"
                            Click="CompleteSelectedTaskButton_Click"/>

                    <Button Content="Delete Selected"
                            Width="125"
                            Margin="0,0,8,0"
                            Click="DeleteSelectedTaskButton_Click"/>

                    <Button Content="Refresh Tasks"
                            Width="110"
                            Click="RefreshTasksButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="#D9E2EC"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="Images/cybersecurity-art.png"
                       Height="150"
                       Width="300"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                <TextBox x:Name="ChatHistory"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontSize="14"
                         Padding="14"
                         Background="White"
                         Foreground="#243B53"
                         BorderThickness="0"
                         Text="Welcome to the Cybersecurity Awareness Bot!&#10;I'm here to help you learn how to stay safe online."/>
            </Grid>
        </Border>

        <!-- Message Input -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="12"
                BorderBrush="#D9E2EC"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         MinHeight="42"
                         FontSize="14"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"
                         BorderBrush="#BCCCDC"
                         ToolTip="Type your cybersecurity question here"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send  &#x27A4;"
                        Width="110"
                        MinHeight="42"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#147D64"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

 
            
         